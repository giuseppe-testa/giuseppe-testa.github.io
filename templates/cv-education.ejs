<%
const M = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const fmt = d => { if (!d) return "present"; const [y, m] = String(d).split("-"); return m ? `${M[+m - 1]} ${y}` : y; };
%>
```{=html}
<div class="cv-list">
<% for (const item of items) { %>
<div class="cv-row cv-row-block">
<div class="cv-row-line">
<span class="cv-row-main"><%= item.degree %></span>
<% if (item.start) { %><span class="cv-row-meta"><%= fmt(item.start) %> – <%= fmt(item.end) %></span><% } %>
</div>
<div class="cv-row-sub"><%= [item.institution, item.location].filter(Boolean).join(", ") %></div>
<% if (item.thesis) { %><div class="cv-row-note"><strong>Thesis:</strong> “<%= item.thesis %>”</div><% } %>
<% if (item.notes) { %><div class="cv-row-note"><%= item.notes %></div><% } %>
</div>
<% } %>
</div>
```
